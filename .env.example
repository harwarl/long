TELEGRAM_BOT_TOKEN=
LONG_CHANNEL_ID=                # bot must be admin in both channels
BANKR_CHANNEL_ID=

RH_WSS_URL=                     # Robinhood Chain WSS RPC
BASE_WSS_URL=                   # Base WSS RPC

BANKR_GRAD_MODE=curve           # curve | mcap
BANKR_MCAP_USD=100000           # only used when mode=mcap
BANKR_TRACK_TTL_HOURS=48        # stop tracking a pool after this with no graduation

STATE_FILE=./state.json

# --- Bankr filter (at least one is required; run `npm run verify` to find them) ---
# Found on Base 2026-10-02: initializer 0xd59ce43e… is used only by integrator 0xae478d76…
# (all launches via ERC-4337 smart wallets). The Scheduled initializer (0xA36715d…) had no launches in range.
BANKR_INITIALIZERS=0xd59ce43e53d69f190e15d9822fb4540dccc91178
# Integrator stored by the Airlock for each launch (getAssetData)
BANKR_INTEGRATOR=0xae478d7652b1ca5da070aa8563fce1570b420db5

# --- Optional toggles / tuning ---
# LONG_ENABLED=true
# BANKR_ENABLED=true
# LONG_POST_ON_EPOCH_END=false  # post at epochEnd even with no Migrate / state change seen
# LONG_FALLBACK_LOOKBACK_BLOCKS=20000
# GETLOGS_CHUNK=2000
# MAX_BACKFILL_BLOCKS=50000
# BANKR_SWAP_TOPIC_CHUNK=200    # pool ids per Swap subscription
# BASE_WETH_USDC_POOL=0xd0b53D9277642d899DF5C87A3966A349A798F224

# --- Post buttons ({token} and {pool} are substituted; empty = no button) ---
# The Long / Robinhood URLs are guesses: check them before going live.
# LONG_CHART_URL=https://dexscreener.com/robinhood/{token}
# LONG_EXPLORER_URL=https://explorer.chain.robinhood.com/token/{token}
# LONG_SITE_URL=https://long.xyz/token/{token}
# BANKR_CHART_URL=https://dexscreener.com/base/{token}
# BANKR_EXPLORER_URL=https://basescan.org/token/{token}
# BANKR_SITE_URL=https://bankr.bot/launches/{token}
