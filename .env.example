TELEGRAM_BOT_TOKEN=
LONG_CHANNEL_ID=                # bot must be admin in both channels
BANKR_CHANNEL_ID=

RH_WSS_URL=                     # Robinhood Chain (4663) WSS RPC

# Graduated = token price reached N× its launch price (no on-chain graduation fires on RH today)
GRAD_MULTIPLE=2
# LONG_GRAD_MULTIPLE=10         # per-pad overrides
# BANKR_GRAD_MULTIPLE=10
TRACK_TTL_HOURS=48              # stop tracking a pool after this with no graduation

RH_GETLOGS_CHUNK=1000           # provider allows ~1001 blocks for older ranges
STATE_FILE=./state.json

# --- Pad attribution (Airlock getAssetData().integrator; Bankr confirmed via api.bankr.bot 2026-10-03) ---
# LONG_INTEGRATOR=0x92d435c96e63c43e12d6d0ab28f6b0b04072f765
# BANKR_INTEGRATOR=0xf60633d02690e2a15a54ab919925f3d038df163e   # comma-separated if more than one

# --- Optional tuning ---
# MAX_BACKFILL_BLOCKS=100000    # ~2.8h; catching up the full cap takes ~5 min
# IGNORE_SWAPS_AFTER_LAUNCH_S=10
# AIRLOCK=0xeb7c034704ef8dcd2d32324c1545f62fb4ad0862
